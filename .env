# 应用名称
VITE_APP_TITLE="智慧管理大屏"

# 本地开发端口（与 auth-web 默认一致；占用时 Vite 会自行换口）
VITE_PORT=5173

# 开发环境 public path
VITE_PUBLIC_PATH=/

# 跨域代理地址
VITE_APP_URL=http://localhost:8801

# 如果端口被占用会直接退出，而不是尝试下一个端口
VITE_STRICT_PORT=false

# 是否在打包时使用 CDN 替换本地库（内网 Docker 部署保持 false）
VITE_CDN=false

# 是否使用 Mock
VITE_MOCK_DEV_SERVER=true

# mock 地址
VITE_MOCK_BASE_API=/mock

# 基础请求路径
VITE_APP_BASE_API=/api

# 是否启用 gzip 压缩（none | gzip）
VITE_COMPRESSION=gzip
